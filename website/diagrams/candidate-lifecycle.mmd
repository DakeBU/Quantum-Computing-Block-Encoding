flowchart LR
  subgraph PREV["Previous layered harness · historical structure"]
    direction TB
    U["Upper strategist / proof architect<br/>choose objectives · compress mathematics · maintain candidate/resource goals"]
    M["Middle Lean-tree manager<br/>decompose the proof DAG · normalize interfaces · scope TODO subtrees"]
    L["Lower focused workers ×N<br/>derive one bounded construction / Lean subtree · return auditable evidence"]
    R["Reviewer / verifier<br/>source + semantic + Lean + resource gates"]
    A["Accepted theorem / reusable certificate"]
    U --> M --> L --> R
    R -- "pass" --> A
    R -- "fail + typed diagnostic" --> M
  end

  subgraph CURR["Current execution contract · frontier ownership"]
    direction TB
    C["Frozen mathematical contract<br/>State Preparation or Block Encoding"]
    F["Frontier Master<br/>own the global proof DAG · identify the real bottleneck · dispatch independent uncertainties"]
    W["Universal Workers ×N<br/>own one substantive mathematical advance end to end<br/>source ↔ math ↔ Lean ↔ diagnostics ↔ exposition"]
    G["Hard promotion gates<br/>source fidelity · semantics · Lean · integration · readable proof"]
    P["Promoted frontier delta<br/>named theorem / reusable interface / sharp obstruction"]
    C --> F --> W --> G --> P
    P -. "update frontier" .-> F
  end

  R -. "verification remains hard;<br/>fixed cognitive castes are removed" .-> G

  classDef old fill:#f7f2e8,stroke:#8b7654,color:#2f2a22,stroke-width:1.4px;
  classDef current fill:#eef4f7,stroke:#35657d,color:#1e2c36,stroke-width:1.6px;
  classDef gate fill:#edf5f1,stroke:#2f7355,color:#18382b,stroke-width:1.6px;
  class U,M,L,R,A old;
  class C,F,W,P current;
  class G gate;
