  (hv : v ≤ 1) (r : ℕ) (hr : r ≤ 2 * k + 1) :
  restrictCoefficients (2 * k + 1) u v (sourceBernsteinCoefficient k) r ∈ Set.Icc 0 (2 * coarseBound k)
QuantumBlockEncoding.ExperimentalCoefficientRange.factorial_output_bound (k : ℕ) : k.factorial ≤ factorialEnvelope k
QuantumBlockEncoding.ExperimentalCoefficientRange.commonDenominator_bound (k r : ℕ) :
  commonDenominator k r ≤ factorialEnvelope k * 2 ^ (2 * k + 1)
QuantumBlockEncoding.ExperimentalCoefficientRange.commonDenominator_pos (k r : ℕ) (hr : r ≤ 2 * k + 1) :
