theorem HermiteLiteralComplexAdapter.realWord_input_eq_primitive : ∀ {width : ℕ} (word : List (Instruction width))
  (m : RealMatrix width),
  castMatrix (realWord word m) =
    (Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)) (evalPrimitiveCircuit (compileWord word)) *
      castMatrix m :=
fun {width} word m =>
  have h := congrArg (⇑(Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width))) (namedCast_word word m);
  Eq.mp
    (congr
