        (congrArg
          (fun _a =>
            (Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)) (evalPrimitiveCircuit (compileWord word)) * _a =
              (Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)) (evalPrimitiveCircuit (compileWord word)))
