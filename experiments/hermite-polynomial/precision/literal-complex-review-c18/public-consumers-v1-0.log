        (realWord_input_eq_primitive word realIdentity)))
    (have h :=
      Matrix.ext fun i j =>
        if h : i = j then
          of_eq_true
            (Eq.trans
              (congr
                (congrArg Eq
                  (congrArg Complex.ofReal (ite_cond_eq_true 1 0 (Eq.trans (congrFun' (congrArg Eq h) j) (eq_self j)))))
                (ite_cond_eq_true 1 0 (Eq.trans (congrFun' (congrArg Eq h) j) (eq_self j))))
              (eq_self 1))
        else
          of_eq_true
            (Eq.trans
              (congr (congrArg Eq (congrArg Complex.ofReal (ite_cond_eq_false 1 0 (eq_false h))))
                (Matrix.one_apply_ne (of_eq_true (Eq.trans (congrArg Not (eq_false h)) not_false_eq_true))))
