          ((Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)).symm (castMatrix m)))
        (congrArg
          (HMul.hMul
            ((Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)) (evalPrimitiveCircuit (compileWord word))))
          (AlgEquiv.apply_symm_apply (Matrix.reindexAlgEquiv ℂ ℂ (primitiveBasisLEEquiv width)) (castMatrix m)))))
