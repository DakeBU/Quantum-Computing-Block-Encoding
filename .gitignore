/.lake/
/.qbe/
/.claude/
/.env
/.DS_Store

# Keep raw sleep-run directories out of git. Human-facing cycle summaries are
# mirrored under paper-notes/GHL2025/markdown/cycle-summaries/, and self-contained
# Pro prompts are mirrored under runs/pro-prompts/.
/runs/*/
!/runs/pro-prompts/
!/runs/pro-prompts/*.md
!/runs/manual-multiagent/
!/runs/manual-multiagent/**/
!/runs/manual-multiagent/**/*.md
/runs/trials.jsonl
/runs/trials_summary.csv

__pycache__/
*.pyc
/Math Writing Tips.pdf
