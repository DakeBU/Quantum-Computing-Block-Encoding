/.env
/.DS_Store

# Public releases keep curated docs, Lean code, candidate summaries, and proof
# exports. Raw agent traces, local dashboards, and project-paper maintenance
# packets stay local unless a maintainer deliberately curates them.
/HUMAN_STATUS.md
/REPORTS*.md
/findings.md
/runs/**
!/runs/README.md
/runs/trials.jsonl
/runs/trials_summary.csv
/paper-notes/*/markdown/cycle-summaries/
/paper-notes/project-paper/
/paper-notes/problem-exports/*/20*.tex
!/paper-notes/problem-exports/*/latest.tex
/proof-attempts/QBE-AUTO-*/
/proof-blueprints/QBE-AUTO-*
/proof-obligations/QBE-AUTO-*.md
/research-wiki/retrieval-index/QBE-AUTO-*.json
/verifier-feedback/QBE-AUTO-*/
/verifier-feedback/QBE-AUTO-*-*.md

__pycache__/
*.pyc
/Math Writing Tips.pdf
