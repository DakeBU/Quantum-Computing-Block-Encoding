# Executable evidence hashes must survive Windows/Linux checkouts unchanged.
executable-exports/SP-HERMITE-001/** text eol=lf
*.sh text eol=lf

# Publication bindings hash actual proof/configuration/lesson bytes, not a
# newline-normalized approximation. Keep these identical in all checkouts.
QuantumBlockEncoding/**/*.lean text eol=lf
QuantumBlockEncoding/*.lean text eol=lf
ABEISTests/**/*.lean text eol=lf
ABEISTests/*.lean text eol=lf
lean-toolchain text eol=lf
lake-manifest.json text eol=lf
docs/lessons/** text eol=lf

# Independently signed packets are immutable byte artifacts. In particular,
# retain pre-policy CRLF packets as historical evidence; do not rehash them.
reviews/publication/** -text
reviews/internal/** -text

# Experimental source/seals/results have frozen raw-byte evidence too. Keep
# historical CRLF and newer LF packets intact; never silently refresh hashes.
experiments/** -text
failure-memory/** -text

# Frozen migration build receipts retain the runner's original raw bytes.
reports/lean-433-migration/*.json -text

# Preserve the already frozen runtime/configuration bytes too, including
# historical CRLF/mixed endings. This changes Git transport, not local code.
lakefile.lean -text
website/scripts/check_research_publications.py -text
reports/lean-433-migration/*.md -text

# Frozen optional diagnostic packages must retain manifest-bound raw bytes.
tools/primitive_compiler_native_profile_v1/** -text
tools/primitive_compiler_native_profile_ci2/** -text
tools/primitive_compiler_native_profile_ci3/** -text
tools/cubic_c29_kernel_ci1/** -text
